# Copy to .env (never commit .env). Real environment variables override this file.

# Where Gemma 4 runs: "ollama" (local, default) or "gemini" (hosted Gemini API)
DOXOPS_PROVIDER=ollama

# Local Ollama
OLLAMA_HOST=http://localhost:11434
DOXOPS_MODEL=gemma4:e4b

# Hosted fallback (Google AI Studio key); only read when DOXOPS_PROVIDER=gemini
GEMINI_API_KEY=
DOXOPS_GEMINI_MODEL=gemma-4-26b-a4b-it
