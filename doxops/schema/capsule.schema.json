    "ReplacementChoice": {
      "properties": {
        "strategy": {
          "description": "upgrade = same package newer version; replace = different package; stdlib = use the Python standard library; remove = delete unused dependency; declare = add a missing declaration; keep = no change recommended",
          "enum": [
            "upgrade",
            "replace",
            "stdlib",
            "remove",
            "declare",
            "keep"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Distribution name to depend on afterwards, null for stdlib/remove",
          "title": "Package"
        },
        "version_spec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PEP 440 specifier, e.g. '>=3.1.6,<4'",
          "title": "Version Spec"
        },
        "stdlib_module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Standard library module when strategy=stdlib",
          "title": "Stdlib Module"
        }
      },
      "required": [
