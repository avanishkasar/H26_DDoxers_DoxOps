{
  "name": "doxops-browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "DoxOps for GitHub: flags at-risk Python dependencies on GitHub repository pages and hands off to the DoxOps CLI or VS Code for verified fixes.",
  "author": "Team DDoxers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "node build.mjs --test && node --test \"dist-test/*.test.mjs\"",
    "package": "npm run build && node scripts/package.mjs",
    "smoke": "node build.mjs --test && node dist-test/smoke.mjs",
    "store-logo": "node scripts/store-logo.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
