{
  "manifest_version": 3,
  "name": "DoxOps for GitHub",
  "version": "0.1.0",
  "description": "Flags at-risk Python dependencies on GitHub repository pages (observed from PyPI) and hands off to DoxOps for verified fixes.",
  "author": "Team DDoxers",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DoxOps for GitHub",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://pypi.org/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
